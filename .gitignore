# ── Terraform ────────────────────────────────────────────────────────────
# .terraform/ — це кеш провайдерів на ~1.5 ГБ, він відновлюється з
# .terraform.lock.hcl командою `terraform init`. У git йому не місце.
.terraform/
# tfstate містить у відкритому вигляді ВСЕ: ARN, ID ресурсів, часом секрети.
# Комітити його не можна навіть у приватний репозиторій.
*.tfstate
*.tfstate.*
*.tfvars
tfplan*
# ZIP-архіви Lambda збираються з lambdas/ під час `terraform apply`
.build/

# ── Kubernetes ───────────────────────────────────────────────────────────
kubeconfig*
# Справжній Secret (є лише приклад k8s/*/secret-example.yaml)
secret.yaml

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Node ─────────────────────────────────────────────────────────────────
node_modules/
dist/

# ── ОС ───────────────────────────────────────────────────────────────────
.DS_Store
*.pkl
